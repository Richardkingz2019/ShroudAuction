# ── ShroudAuction frontend configuration ────────────────────────────────────
# Copy to `.env` for local development, and set the same keys in the Vercel
# project's Environment Variables for the deployed build.
#
# Network the wallet is asked to connect to: preprod | preview | undeployed.
# The challenge targets Preprod.
VITE_NETWORK_ID=preprod

# The on-chain contract the app talks to.
#
# NOTE: the address below is the Preprod value supplied for Level 2. It is a
# Bech32m `mn_addr_preprod…` value; if circuit calls report "contract not
# found", deploy to Preprod (`npm run deploy -- --network preprod` in the repo
# root) and replace this with the 64-hex contract address the deploy prints.
VITE_CONTRACT_ADDRESS=mn_addr_preprod1yms6jevlk8pvsgv9r4aphjdr283qf3v6yg8lt50vl3yzunn2zh9stxvytv

# Fallback indexer endpoints. A connected wallet's own getConfiguration() takes
# precedence over these, so they only apply before/without a wallet.
VITE_INDEXER_URL=https://indexer.preprod.midnight.network/api/v4/graphql
VITE_INDEXER_WS_URL=wss://indexer.preprod.midnight.network/api/v4/graphql/ws
